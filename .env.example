# Variáveis do ambiente local, lidas pelo Docker Compose (docker-compose.yml) e pelo Taskfile.yml.
# Copie para .env e ajuste se precisar. Todas têm padrão embutido.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=homedex
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# O Compose monta a DATABASE_URL do backend a partir das variáveis acima, no formato
# postgres://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB?sslmode=disable
# (host "postgres" = nome do serviço na rede do Compose; produção usa a string do Neon, com SSL).

# `task dev:backend` e `task migrate` rodam o backend fora do Docker e usam esta DATABASE_URL
# (padrão do Taskfile: o Postgres do Compose publicado no host). Uma DATABASE_URL exportada no
# shell tem precedência sobre as duas.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/homedex?sslmode=disable

# Para a CLI falar com o backend do Compose em vez de produção:
# HOMEDEX_API_URL=http://localhost:8080
